[sub_resource type="Resource" id="win_ch1"]
script = ExtResource("3_win")
required_neutral_conquests = 3
must_defeat_all_enemies = true
description_key = &"WIN_CONDITION_CH1"

[resource]
script = ExtResource("1_chapter")
chapter_id = 1
chapter_name_key = &"CHAPTER_1_TITLE"
actions_per_turn = 1
enemy_actions_per_turn = 1
regions = [SubResource("region_otuken"), SubResource("region_bati"), SubResource("region_dogu"), SubResource("region_altai"), SubResource("region_guney"), SubResource("region_sinir")]
win_condition = SubResource("win_ch1")
