[gd_resource type="Resource" script_class="ChapterMapDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://features/grid/chapter_map_definition.gd" id="1_chapter"]
[ext_resource type="Script" path="res://features/grid/region_definition.gd" id="2_region"]
[ext_resource type="Script" path="res://features/grid/win_condition.gd" id="3_win"]

[sub_resource type="Resource" id="region_otuken"]
script = ExtResource("2_region")
region_id = &"otuken"
display_name_key = &"REGION_OTUKEN"
owner = 1
starting_army = 5
gold_per_turn = 2
position = Vector2(960, 450)
polygon_points = PackedVector2Array(880, 370, 1040, 370, 1080, 450, 1040, 530, 880, 530, 840, 450)
adjacent_region_ids = Array[StringName]([&"bati_bozkir", &"dogu_bozkir", &"altai", &"guney_vadi"])

