; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Steppeborn: Path of the Sky Wolf"
config/description="Gök kurt Kök Böri'nin rehberliğinde Oğuz Kağan Destanı: dört yöne fetih, Erlik'in bozgununa karşı arınma."
run/main_scene="res://contexts/root_context/root_context.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://assets/fonts/default_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://assets/locale/translations.en.translation", "res://assets/locale/translations.tr.translation", "res://assets/locale/translations.de.translation", "res://assets/locale/translations.fr.translation", "res://assets/locale/translations.es.translation", "res://assets/locale/translations.zh.translation", "res://assets/locale/translations.ja.translation", "res://assets/locale/translations.ko.translation", "res://assets/locale/translations.ru.translation", "res://assets/locale/translations.pt.translation", "res://assets/locale/translations.ar.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
